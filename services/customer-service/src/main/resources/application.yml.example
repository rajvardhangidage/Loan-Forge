# ===================================================================
# Customer Service Configuration Template
# Copy this file to 'application.yml' in the same directory:
#   cp application.yml.example application.yml
# ===================================================================

server:
  port: 8082

spring:
  application:
    name: customer-service
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/customerdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true}
    username: ${DB_USERNAME:your_db_username}
    password: ${DB_PASSWORD:your_db_password}
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        type:
          preferred_uuid_jdbc_type: VARCHAR
    open-in-view: false
  flyway:
    enabled: true

management:
  endpoints:
    web:
      exposure:
        include: health,info

app:
  jwt:
    # Must match the JWT secret configured across all services
    secret: ${JWT_SECRET:replace-with-a-secure-256-bit-secret-key-for-jwt-tokens}
