# ===================================================================
# API Gateway Configuration Template
# Copy this file to 'application.yml' in the same directory:
#   cp application.yml.example application.yml
# ===================================================================

server:
  port: 8080

spring:
  application:
    name: api-gateway
  cloud:
    gateway:
      globalcors:
        cors-configurations:
          '[/**]':
            allowedOrigins: "*"
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
            allowedHeaders: "*"
      routes:
        - id: auth
          uri: ${AUTH_URL:http://localhost:8081}
          predicates:
            - Path=/api/v1/auth/**
        - id: customer
          uri: ${CUSTOMER_URL:http://localhost:8082}
          predicates:
            - Path=/api/v1/customers/**
        - id: payment
          uri: ${PAYMENT_URL:http://localhost:8084}
          predicates:
            - Path=/api/v1/payments/**
        - id: loan
          uri: ${LOAN_URL:http://localhost:8083}
          predicates:
            - Path=/api/v1/loans/**
        - id: notification
          uri: ${NOTIFICATION_URL:http://localhost:8085}
          predicates:
            - Path=/api/v1/notifications/**

management:
  endpoints:
    web:
      exposure:
        include: health,info
